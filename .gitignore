# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Dynamic data & user uploads (keeps structure via .gitkeep)
data/private_uploads/academic/*
!data/private_uploads/academic/.gitkeep
data/private_uploads/resume/*
!data/private_uploads/resume/.gitkeep
data/resume.json
